# ─────────────────────────────────────────────
# Application
# ─────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# ─────────────────────────────────────────────
# PostgreSQL (via Prisma)
# ─────────────────────────────────────────────
DATABASE_URL="postgresql://posuser:pospassword@localhost:5432/posdb?schema=public"

# ─────────────────────────────────────────────
# Redis
# ─────────────────────────────────────────────
REDIS_URL="redis://localhost:6379"
REDIS_HOST=localhost
REDIS_PORT=6379

# ─────────────────────────────────────────────
# JWT
# ─────────────────────────────────────────────
JWT_SECRET="change-this-to-a-strong-random-secret-min-32-chars"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="change-this-to-another-strong-random-secret-min-32-chars"
JWT_REFRESH_EXPIRES_IN="7d"

# ─────────────────────────────────────────────
# CORS
# ─────────────────────────────────────────────
CORS_ORIGINS="http://localhost:5173,http://localhost:3001"

# ─────────────────────────────────────────────
# Swagger
# ─────────────────────────────────────────────
SWAGGER_ENABLED=true
